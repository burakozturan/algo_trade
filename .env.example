# Copy this file to .env and edit locally.
# Do not commit .env.

# IBKR / TWS configuration
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Discord alerting
DISCORD_WEBHOOK_URL=

# Runtime settings
LOG_LEVEL=INFO
DRY_RUN=true
## Copy to .env and edit values for your environment
# IB / TWS connection
TWS_HOST=127.0.0.1
TWS_PORT=4001
CLIENT_ID=17533939
USE_RTH=true

# IB REST API helper (if used)
IB_API_BASE_URL=https://localhost:5000/v1/api
